
APP_ENV=dev
LOG_LEVEL=INFO

DATABASE_URL=postgresql+asyncpg://lenny:lenny@db:5432/lenny

LLM_PROVIDER=ollama
FALLBACK_PROVIDER=
LLM_TIMEOUT_SECONDS=120

OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_CHAT_MODEL=qwen2.5:3b
OLLAMA_EMBED_MODEL=nomic-embed-text

CLOUD_API_KEY=
CLOUD_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
CLOUD_MODEL=gemini-2.0-flash

# Knowledge base
TRANSCRIPTS_DIR=/data/transcripts/episodes
RETRIEVAL_TOP_K=4
RETRIEVAL_MIN_SCORE=0.45